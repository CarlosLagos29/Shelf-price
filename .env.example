# Copiar a .env y completar. Nunca commitear el .env real.

# Neon — conexión POOLED (host con "-pooler"). La usa la app en runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=10"

# Neon — conexión DIRECTA (host sin "-pooler"). La usa el CLI de Prisma (migraciones).
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require&connect_timeout=10"

# Secreto para cifrar la cookie de sesión (iron-session). Mínimo 32 caracteres.
# Generar con: openssl rand -base64 32
SESSION_SECRET="reemplazar-por-un-secreto-de-al-menos-32-caracteres"

# Minutos durante los que un EMPLOYEE puede anular su propia venta.
SALE_VOID_WINDOW_MINUTES="30"

# Habilita el modo demo (banner + seed de ejemplo). "true" | "false"
DEMO_MODE="false"
